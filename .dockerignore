# Keep local state, credentials and downloaded runtimes out of build contexts.
.git
node_modules
dist
.runtime
.data
artifacts
release
coverage
.venv
.venv-test
**/__pycache__
**/*.pyc
**/.env
**/.env.*
!**/.env.example
!**/*.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/credentials.json
**/state.json
**/cloud-owner-token
**/*.log
**/.DS_Store
**/._*
